# Local development uses the in-memory corpus when WORD_FINDER_STORE is omitted.
# Production on Amplify should set WORD_FINDER_STORE=dynamodb.
# Table names are read from Amplify custom outputs when amplify_outputs.json is generated;
# explicit WORD_FINDER_*_TABLE values override those outputs if set.
# Attach the generated wordFinderComputeRoleArn as the Amplify Hosting compute role.
WORD_FINDER_STORE=memory
AWS_REGION=us-east-1
WORD_FINDER_DICTIONARY_TABLE=
WORD_FINDER_DISCOVERED_TABLE=
WORD_FINDER_NOTES_TABLE=
WORD_FINDER_DAILY_STATS_TABLE=
WORD_FINDER_NOTE_HASH_SALT=replace-with-a-secret-random-string
